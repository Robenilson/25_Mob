{
  "expo": {
    "name": "mobapp",
    "slug": "mobapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "NSContactsUsageDescription": "Precisamos acessar seus contatos para adicionar pessoas de confiança.",
        "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Precisamos da sua localização para mostrar o endereço de embarque."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "permissions": ["READ_CONTACTS", "WRITE_CONTACTS", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION" ]

      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
    
  }
}


